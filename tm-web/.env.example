# tm-web (Trovo Manager website) settings.
#   cp .env.example .env.local     then edit .env.local (never committed)
# Every setting is explained in CONFIGURATION.md.
#
# All of these are read when the website is BUILT (yarn dev / yarn build, or
# docker build --build-arg ...), not when it runs. NEXT_PUBLIC_* values are
# visible in the browser: never put a secret in one.

# Admin API base URL. Points at tm-api, whose default PORT (see
# tm-api/internal/server/models/server.go) is 8082 when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8082/api/v1

# --- Error reporting (all optional) ------------------------------------------
# GlitchTip project DSN for the web app. Leave empty to disable: the SDK stays
# dormant, nothing is sent, and the bundle is unchanged.
NEXT_PUBLIC_SENTRY_DSN=
# Environment shown on error reports (development | staging | production).
NEXT_PUBLIC_APP_ENV=development
# Build identifier attached to reports. CI passes the git sha.
NEXT_PUBLIC_APP_VERSION=

# --- Source-map upload (CI only, opt-in) -------------------------------------
# Uploads source maps so stack traces name real components instead of minified
# output. Set SENTRY_UPLOAD_SOURCEMAPS=1 AND all four values below to enable.
#
# Get the org and project slugs from the GlitchTip URL after logging in:
#   https://errors.dev.trovo.app/<org-slug>/<project-slug>/
# A wrong slug makes sentry-cli abort the build, which is why this is opt-in
# rather than automatic whenever credentials happen to be present.
SENTRY_UPLOAD_SOURCEMAPS=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=https://errors.dev.trovo.app
