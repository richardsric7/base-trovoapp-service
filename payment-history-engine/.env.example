# payment-history-engine settings. Copy to .env and fill in.
# Every setting is explained (what, why, example, how to get it) in
# CONFIGURATION.md.

# --- Main database: app-backend's (required) ---
DB_TYPE=postgres
DB_CONNECTION_STRING=postgres://wallet_user:wallet_pass@localhost:5432/trovo_wallet?sslmode=disable
# DB_MAX_OPEN_CONNECTIONS=50
# DB_MAX_IDLE_CONNECTIONS=50

# --- Tracking database, "RoachDB" (required) ---
CDB_CONNECTION_STRING=postgresql://root@localhost:26257/payment_history?sslmode=disable
# ROACH_DB_TYPE=sqlite        # local only: CDB_CONNECTION_STRING is then a file path

# --- Blockchain (required) ---
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532           # 8453 on Base Mainnet
NATIVE_ASSET_CODE=ETH
# ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
# RPC_TIMEOUT=30s
# TRACK_ADDRESS_CONCURRENCY=8
# LAST_CURSOR=

# --- Caching (ENABLE_CACHING is required: 0 or 1) ---
ENABLE_CACHING=0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# CACHING_PARAMETER=v1

# --- Health server ---
# HEALTH_PORT=8080

# --- Discord alerts (optional; built-in fallbacks otherwise) ---
# CONNECTION_WARNING_WEBHOOK=
# EXPANSION_NETWORK_ERROR_WEBHOOK=
# FAILED_PAYMENT_ERROR_WEBHOOK=
