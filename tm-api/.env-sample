# Admin, wallet, and P2P schemas all live in this one database now - this
# is the only DB connection the service opens (see internal/db.AdminDB).
ADMIN_CONNECTION_STRING='host=localhost user=postgres password=postgres dbname=admin_dashboard port=5432 sslmode=disable'
JWT_SECRET='replace-with-organization-member-jwt-secret'
TROVO_WALLET_BASE_URL=https://walletdev.trovotechnologies.com
SERVICE_LINK_USERNAME=trovo-manager
SERVICE_LINK_API_KEY=replace-with-service-link-api-key
LOGIN_CALLBACK_URL=https://dashboarddev.trovotechnologies.com/api/v1
TROVO_MANAGER_FRONTEND_URL=https://admin-app-dashboard-w9dxf.ondigitalocean.app
TROVO_MANAGER_BASE_URL=https://dashboarddev.trovotechnologies.com/api/v1
# Optional. Comma-separated allow-list restricting which origins get a credentialed
# cross-origin response. Leave unset to allow any origin (the default) — every legitimate
# frontend origin (dashboard, organisation portal, previews) must be listed here before
# setting this, or those origins get CORS-blocked outright.
# CORS_ALLOWED_ORIGINS=https://admin-app-dashboard-w9dxf.ondigitalocean.app
ENABLE_CACHING=0
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=replace-with-vault-token
PERSONAL_ENVS='AUTO_APPROVE:Auto Approval,MARKET_MAKER:Market Maker'
PERSONAL_ENV_VAULT_MOUNT=secret
PERSONAL_ENV_VAULT_PATH_PREFIX=personal-envs

# --- Observability -----------------------------------------------------------
# GlitchTip project DSN for crash reporting. Leave empty to disable: panics are
# then recovered and logged locally instead of being reported.
SENTRY_DSN=
# Environment name shown on error reports (development | staging | production).
APP_ENV=development
# Build identifier reported by /health and attached to error reports. CI passes
# the git sha automatically; set it here only for local runs.
APP_VERSION=

# --- System health module (Trovo Manager observability screens) ---------------
# All optional. Each unset value disables its screen, which reports "not
# configured" rather than showing an empty result. These are internal service
# names on the Docker network - the browser never contacts them directly.
#
# Backends the health screen polls, as name=url pairs. Configured rather than
# derived because container names do not follow one convention across
# environments (the P2P container is p2p-dev, not p2p-api-dev).
OBSERVABILITY_SERVICES=admin-api=http://admin-api-dev:8080,wallet-api=http://wallet-api-dev:8080,p2p-api=http://p2p-dev:8080
# Metrics, for the health screen's host panel and the trends charts.
PROMETHEUS_URL=http://prometheus:9090
# Log aggregation, for tracing a request across services.
LOKI_URL=http://loki:3100
# Crash reporter, for the issues screen. All three are needed together.
GLITCHTIP_URL=http://glitchtip-web:8000
GLITCHTIP_API_TOKEN=
GLITCHTIP_ORG=
# Where a browser reaches the crash reporter. Distinct from GLITCHTIP_URL
# above, which is the internal address this service calls - a link handed to a
# user must be a hostname their browser can resolve.
GLITCHTIP_PUBLIC_URL=
# Public Grafana URL, shown as an "open in Grafana" link for engineers.
GRAFANA_URL=
