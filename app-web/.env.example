# app-web settings for the dev server (npm start).
#   cp .env.example .env.local     then edit .env.local (never committed)
# Every setting is explained in CONFIGURATION.md. These values are copied
# into the website when it is built, so never put a secret here.
#
# With Docker you don't need this file: leave these unset and give the
# container BACKEND_URL instead (see DEPLOYMENT.md).

# app-backend running on your machine (app-backend/DEPLOYMENT.md):
VITE_API_URL=http://localhost:8080

# Or a shared app-backend:
# VITE_API_URL=https://api.trovo.example.com

# Read but not used yet (the website opens no websocket today):
# VITE_SOCKET_URL=ws://localhost:8080/v1

# Flutterwave PUBLIC key for "buy with card" (never the secret key). Unset
# hides the card payment.
# VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
