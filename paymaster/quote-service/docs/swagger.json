{
    "swagger": "2.0",
    "info": {
        "description": "Signs ERC-4337 paymaster quotes so Trovo wallets can pay gas in stablecoins (USDC, USDT, cNGN, ...) at market rates plus Trovo's spread.",
        "title": "Trovo Paymaster Quote Service",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/healthz": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Liveness",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Readiness: every gas token has a fresh rate and the deposit is known",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/v1/quote": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Prices the operation's gas in the chosen stablecoin (market rate plus Trovo's spread), signs it, and returns the paymaster fields to put in the UserOperation before the wallet owner signs it. The quote is bound to every field of the operation; changing any of them after quoting makes the paymaster reject it.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "quotes"
                ],
                "summary": "Sign a gas quote for a UserOperation",
                "parameters": [
                    {
                        "description": "Operation and gas token",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.QuoteRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/quote.Result"
                        }
                    },
                    "400": {
                        "description": "invalid request or unknown token",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "the wallet owes the paymaster",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "rates, chain or deposit unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/rates": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "quotes"
                ],
                "summary": "Every rate pair with each source's latest answer",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/rates.Price"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/status": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Paymaster, signer and deposit status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.StatusResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/tokens": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "For showing users an estimated fee before they send: fee in token = gas (wei) × exchangeRate / 1e18 base units.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "quotes"
                ],
                "summary": "Gas tokens and the current price of 1 ETH in each",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/api.TokenInfo"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "rate-unavailable"
                },
                "message": {
                    "type": "string",
                    "example": "rate USD/NGN is stale"
                }
            }
        },
        "api.QuoteRequest": {
            "type": "object",
            "properties": {
                "token": {
                    "description": "Gas token symbol (\"USDC\") or address.",
                    "type": "string",
                    "example": "cNGN"
                },
                "userOp": {
                    "$ref": "#/definitions/api.UserOperation"
                },
                "validitySeconds": {
                    "description": "How long the quote stays valid; 0 = the service default. Shared\nwallets waiting for approvals ask for longer (up to QUOTE_MAX_VALIDITY).",
                    "type": "integer",
                    "example": 600
                }
            }
        },
        "api.StatusResponse": {
            "type": "object",
            "properties": {
                "chainId": {
                    "type": "string"
                },
                "deposit": {
                    "$ref": "#/definitions/monitor.Status"
                },
                "entryPoint": {
                    "type": "string"
                },
                "paymaster": {
                    "type": "string"
                },
                "signer": {
                    "type": "string"
                }
            }
        },
        "api.TokenInfo": {
            "type": "object",
            "properties": {
                "decimals": {
                    "type": "integer"
                },
                "error": {
                    "type": "string"
                },
                "exchangeRate": {
                    "description": "QuotedRate in base units: what the paymaster uses",
                    "type": "string"
                },
                "marketRate": {
                    "description": "tokens per ETH at market",
                    "type": "string"
                },
                "quotedRate": {
                    "description": "tokens per ETH with the spread",
                    "type": "string"
                },
                "ratesAsOf": {
                    "type": "string"
                },
                "spreadBps": {
                    "type": "integer"
                },
                "symbol": {
                    "type": "string"
                },
                "token": {
                    "type": "string"
                }
            }
        },
        "api.UserOperation": {
            "type": "object",
            "properties": {
                "callData": {
                    "type": "string",
                    "example": "0x7bb37428..."
                },
                "callGasLimit": {
                    "type": "string",
                    "example": "0x30d40"
                },
                "factory": {
                    "type": "string",
                    "example": "0x4e1DCf7AD4e460CfD30791CCC4F9c8a4f820ec67"
                },
                "factoryData": {
                    "type": "string",
                    "example": "0x1688f0b9..."
                },
                "initCode": {
                    "type": "string",
                    "example": "0x"
                },
                "maxFeePerGas": {
                    "type": "string",
                    "example": "0x3b9aca00"
                },
                "maxPriorityFeePerGas": {
                    "type": "string",
                    "example": "0xf4240"
                },
                "nonce": {
                    "type": "string",
                    "example": "0x0"
                },
                "paymasterPostOpGasLimit": {
                    "type": "string",
                    "example": "0x13880"
                },
                "paymasterVerificationGasLimit": {
                    "type": "string",
                    "example": "0x249f0"
                },
                "preVerificationGas": {
                    "type": "string",
                    "example": "0xea60"
                },
                "sender": {
                    "type": "string",
                    "example": "0x5a6B0c1C6f1C0F4b1d7aA2d1C3e0bEe8a9F2d4c1"
                },
                "verificationGasLimit": {
                    "type": "string",
                    "example": "0x493e0"
                }
            }
        },
        "monitor.Status": {
            "type": "object",
            "properties": {
                "checkedAt": {
                    "type": "string"
                },
                "depositEth": {
                    "type": "string"
                },
                "depositWei": {
                    "type": "string"
                },
                "error": {
                    "type": "string"
                },
                "low": {
                    "type": "boolean"
                },
                "lowWatermarkEth": {
                    "type": "string"
                }
            }
        },
        "quote.Result": {
            "type": "object",
            "properties": {
                "exchangeRate": {
                    "type": "string"
                },
                "marketRate": {
                    "type": "string"
                },
                "maxCostWei": {
                    "type": "string"
                },
                "maxTokenCost": {
                    "type": "string"
                },
                "maxTokenCostFormatted": {
                    "type": "string"
                },
                "paymaster": {
                    "type": "string"
                },
                "paymasterAndData": {
                    "type": "string"
                },
                "paymasterData": {
                    "type": "string"
                },
                "paymasterPostOpGasLimit": {
                    "type": "string"
                },
                "paymasterVerificationGasLimit": {
                    "type": "string"
                },
                "quoteHash": {
                    "type": "string"
                },
                "quotedRate": {
                    "type": "string"
                },
                "signer": {
                    "type": "string"
                },
                "spreadBps": {
                    "type": "integer"
                },
                "symbol": {
                    "type": "string"
                },
                "token": {
                    "type": "string"
                },
                "validAfter": {
                    "type": "integer"
                },
                "validUntil": {
                    "type": "integer"
                }
            }
        },
        "rates.Price": {
            "type": "object",
            "properties": {
                "error": {
                    "description": "why the last refresh failed, if it did",
                    "type": "string"
                },
                "pair": {
                    "type": "string"
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/rates.SourceResult"
                    }
                },
                "updatedAt": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                }
            }
        },
        "rates.SourceResult": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "outlier": {
                    "type": "boolean"
                },
                "value": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "type": "apiKey",
            "name": "X-API-Key",
            "in": "header"
        }
    }
}