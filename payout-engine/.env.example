# payout-engine - see CONFIGURATION.md for what each value does and where to get it.

# app-backend's database (app-backend creates the tables)
DB_TYPE=postgres
DB_CONNECTION_STRING=host=localhost user=trovo password=change-me dbname=trovo port=5432 sslmode=disable
DB_MAX_OPEN_CONNECTIONS=10

# Base
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532

# the Safe that pays proceeds (owners: the signers below)
PROCEED_PAYOUT_SAFE_ADDRESS=
# managed secret: ';'-separated private keys, at least 3 (the first executes and pays gas)
PROCEED_PAYOUT_SIGNERS=
# or read it from Vault on every use instead:
# PROCEED_PAYOUT_SIGNERS_VAULT_PATH=secret/trovo/payout-engine#PROCEED_PAYOUT_SIGNERS
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=
# VAULT_NAMESPACE=

# optional
# SAFE_MULTISEND_CALL_ONLY_ADDRESS=0x9641d764fc13c8B624c04430C7356C1C7C8102e2
OFFER_BOOK_ADDRESS=
PROCEED_PAYOUT_SWEEP_ADDRESS=
PROCEED_PAYOUT_EXCLUDED_ADDRESSES=
TOKENIZATION_ISSUING_PROFILE=atprofile
VAT_WALLET=

# tuning (defaults shown)
# PROCEED_PAYOUT_CONFIRMATIONS=3
# PROCEED_PAYOUT_LOG_CHUNK=5000
# PROCEED_PAYOUT_CATCH_UP_WITHIN=2
# PROCEED_PAYOUT_BATCH_SIZE=150
# PROCEED_PAYOUT_MAX_BATCH_GAS=12000000
# PROCEED_PAYOUT_MIN_UNITS=1
# PROCEED_PAYOUT_GAS_PRICE_MULTIPLIER=1
# PROCEED_PAYOUT_POLL_SECONDS=10
# PROCEED_PAYOUT_RECEIPT_TIMEOUT_SECONDS=180
# PROCEED_PAYOUT_DEFAULT_START_BLOCK=0

# Redis (same as tm-api; optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=0

# Firebase service account JSON, base64 (push notifications; optional)
GC=

# INSTANCE_ID=payout-engine-1
# APP_VERSION=dev
