# Copy to .env.local and adjust for your setup.
# .env.local is gitignored - values here are per-developer.
#
# When unset, the app falls back to /api and /ws/v1 (same-origin),
# which is what production and the Docker build use. Set these only
# when running the Vite dev server locally where nginx isn't present.

# Hit the deployed dev backend directly (easiest):
VITE_API_URL=https://api.dev.trovo.app
VITE_SOCKET_URL=wss://api.dev.trovo.app/v1

# Or hit a locally running backend:
# VITE_API_URL=http://localhost:8080
# VITE_SOCKET_URL=ws://localhost:8080/v1
