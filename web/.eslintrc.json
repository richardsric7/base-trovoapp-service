{
    "env": {
      "browser": true,
      "es2021": true
    },
    "extends": "airbnb",
      "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "plugins": ["react", "react-hooks"],
    "rules": {
      //add customize rules here as per your project's needs
      "import/no-named-as-default": 0
    }
}  