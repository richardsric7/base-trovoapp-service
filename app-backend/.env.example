DB_TYPE=sqlite
DB_CONNECTION_STRING=bantupay.sqlite
DB_AUTOMIGRATE=1
ORGANISATION='bantupay'
VERIFICATION_CODE_SALT=WhateverYouWant

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=465
SMTP_PASSWORD=password
SMTP_USERNAME=username

MAIL_FROM=test@test.com

BASE_RPC_URL=https://sepolia.base.org
# BLOCKCHAIN_NETWORK_PASSPHRASE / BLOCKCHAIN_BASE_RESERVE are vestigial on
# Base (Stellar-era signature-domain and account-reserve concepts EVM has
# no equivalent of) - no longer required, left here only if some code path
# still reads them.
BLOCKCHAIN_NETWORK_PASSPHRASE=
BLOCKCHAIN_BASE_RESERVE=

MNEMONIC_TEMP_ACCOUNTS = 24 words sha

# P2P escrow Safe (internal/components/p2p/safesigner). P2P_ESCROW_WALLET_ADDRESS
# is the Gnosis Safe's own address (both the escrow deposit destination and
# the Safe execTransaction is sent to). P2P_ESCROW_SIGNERS is a ";"-separated
# (legacy "," also accepted) list of at least 3 signer private keys/mnemonics,
# the first of which also broadcasts and pays gas for every settlement.
# P2P_ESCROW_MULTISEND_ADDRESS overrides the default canonical
# MultiSendCallOnly v1.3.0 address safesigner batches same-token settlement
# legs through - only needed if this network's Safe deployment uses a
# different MultiSendCallOnly address than the standard one.
P2P_ESCROW_WALLET_ADDRESS=
P2P_ESCROW_SIGNERS=
P2P_ESCROW_MULTISEND_ADDRESS=

DOLLAR_ASSET=USDB:0x0000000000000000000000000000000000000000
TROV_ASSET_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
IPAPI_HOST=
IPAPI_KEY=
DB_AUTOMIGRATE=1
ENABLE_OLD_USER_MIGRATION=1
GAS_FAUCET=
REWARD_FAUCET=
REWARD_ASSET_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
REWARD_ASSET_CODE=BNR
ENABLE_REFERRAL_REWARD=
REFERRAL_REWARD_AMOUNT=

ENABLE_CACHING=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
FBDL_SERVICE_URLS=

# Private GCS bucket used only for stakeholder portal documents.
STAKEHOLDER_DOCUMENTS_BUCKET_NAME=
