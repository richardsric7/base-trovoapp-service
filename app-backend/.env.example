# app-backend settings template.
#
#   cp .env.example .env     then fill in the values
#
# Every setting is explained in CONFIGURATION.md: what it is, why it is
# needed, an example and how to get a real value. Values here are local
# development placeholders, never real secrets. Never commit your .env.

# ---------------------------------------------------------------------------
# REQUIRED: app-backend stops at start if any of these is empty
# ---------------------------------------------------------------------------

# Database (CONFIGURATION.md section 2). Local: Postgres in Docker, see
# DEPLOYMENT.md step 3. DB_TYPE=sqlite with a file name also works locally.
DB_TYPE=postgres
DB_CONNECTION_STRING=host=localhost user=trovo password=change-me dbname=trovo port=5432 sslmode=disable
# payment-history-engine's tracking database (Postgres or CockroachDB)
CDB_CONNECTION_STRING=postgresql://trovo:change-me@localhost:5432/trovo_tracking?sslmode=disable

# Redis (section 3). REDIS_HOST and REDIS_PORT are checked even with caching off.
ENABLE_CACHING=0
REDIS_HOST=localhost
REDIS_PORT=6379

# Blockchain (section 5)
BASE_RPC_URL=https://sepolia.base.org
NATIVE_ASSET_CODE=ETH
# CODE:token-contract-address of the US dollar stablecoin
DOLLAR_ASSET=USDC:0x036CbD53842c5426634e7929541eC2318f3dCF7e
# seconds
BLOCKCHAIN_DATA_CACHE_LIFETIME=94608000
CNGN_PRICE_API_URL=http://localhost:8095
DEFAULT_ASSET_IMAGE_URL=https://cdn.trovo.example.com/assets/default.png
NATIVE_ASSET_IMAGE_URL=https://cdn.trovo.example.com/assets/eth.png

# Salts and derived keys (section 7). Generate with: openssl rand -hex 16
# NEVER change ENCODER_SALT or the market-making / bulk-payment values after
# launch: existing users' security answers and signing keys depend on them.
VERIFICATION_CODE_SALT=
ENCODER_SALT=
MNEMONIC_MARKET_MAKING=
MARKET_MAKING_SALT=
MNEMONIC_BULK_PAYMENT=
BULK_PAYMENT_SALT=

# Channel accounts (section 8): legacy, still checked at start. One dedicated
# key that holds no funds, and the settings below so nothing is spent.
CHANNEL_ACCOUNTS=
CHANNEL_ACCOUNT_FUNDER=
CHANNEL_ACCOUNT_MIN_COUNT=0
CHECK_CHANNEL_ACCOUNT_BALANCE=0

# Fee wallets (section 9): addresses that receive each kind of fee
VAT_WALLET=
PAYMENT_FEE_WALLET=
SWAP_FEE_WALLET=
SHARED_ACCESS_PAYMENT_FEE_WALLET=
SUBWALLET_CREATION_FEE_WALLET=
TOKENIZATION_APPLICATION_FEE_WALLET=
TOKENIZATION_FEE_WALLET=
CLOSED_GROUP_FEE_WALLET=
ACCOUNT_RECOVERY_FEE_WALLET=
PATRON_FEE_WALLET=
SWAP_FEE_ENABLED=1
MARKET_MAKING_FEE_ENABLED=0

# Email (section 17)
MAILGUN_PRIVATE_API_KEY=
MAILGUN_DOMAIN=mg.trovo.example.com
ENABLE_EMAIL_VALIDATION=0

# Firebase and links (section 19)
# base64 of the Firebase service account JSON: base64 -w0 key.json
GC=
GOOGLE_PROJECT_ID=
DYNAMIC_LINKS_DOMAIN_PREFIX=trovo.page.link
DYNAMIC_LINKS_ANDROID_PACKAGE_NAME=app.trovo.wallet
DYNAMIC_LINKS_IOS_BUNDLE_ID=app.trovo.wallet
DYNAMIC_LINKS_FALLBACK_BASE_URL=http://localhost:3000
WALLET_DOMAIN=trovo.app

# Login tokens (section 20). Secret: openssl rand -hex 32. Expiries in minutes.
JWT_ACCESS_SECRET=
JWT_TOKEN_EXPIRY=15
JWT_REFRESH_TOKEN_EXPIRY=1440

# Location lookup (section 22): checked at start but not called today
IPAPI_HOST=https://api.ipapi.com/api
IPAPI_KEY=

# ---------------------------------------------------------------------------
# STRONGLY RECOMMENDED: without these wallets cannot send anything
# ---------------------------------------------------------------------------

BASE_CHAIN_ID=84532
BUNDLER_URL=
PAYMASTER_ADDRESS=
PAYMASTER_QUOTE_SERVICE_URL=
PAYMASTER_QUOTE_SERVICE_API_KEY=

# ---------------------------------------------------------------------------
# SERVER (section 1)
# ---------------------------------------------------------------------------

PORT=8080
# GIN_MODE=release
# 1 = update the database tables at start (local / single server)
DB_AUTOMIGRATE=1
# SHUTDOWN_GRACE_PERIOD=60s

# ---------------------------------------------------------------------------
# OPTIONAL FEATURES: uncomment what you use (see CONFIGURATION.md)
# ---------------------------------------------------------------------------

# Rate limits (section 4)
# RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Tokenization (section 10)
# ENABLE_ASSET_TOKENIZATION=1
# TOKENIZATION_ISSUING_PROFILE=
# OFFER_BOOK_ADDRESS=
# OFFER_AUTHORIZER_PRIVATE_KEY=
# OFFER_BOOK_START_BLOCK=
# INTERNAL_BALANCE_ISSUING_SIGNERS=

# Account recovery (section 11)
# RECOVERY_MODULE_ADDRESS=
# RECOVERY_PERIOD_SECONDS=604800
# ACCOUNT_RECOVERY_GUARDIAN_SAFE=
# ACCOUNT_RECOVERY_GUARDIAN_SIGNERS=

# P2P escrow (section 12)
# P2P_ESCROW_WALLET_ADDRESS=
# P2P_ESCROW_SIGNERS=

# Public Markets (section 13)
# PUBLIC_MARKETS_SIGNERS=
# PUBLIC_MARKETS_TREASURY_SAFE=
# PUBLIC_MARKETS_PARTNER_WALLET_THRESHOLD=3
# PUBLIC_MARKETS_MOCK_EXECUTION_SECONDS=20
# PUBLIC_MARKETS_MOCK_SETTLEMENT_SECONDS=60

# Faucets and rewards (section 16)
# GAS_FAUCET=
# REWARD_FAUCET=
# REWARD_ASSET_CODE=TROV
# REWARD_ASSET_CONTRACT_ADDRESS=

# File storage (section 19)
# STORAGE_BUCKET_NAME=
# STAKEHOLDER_DOCUMENTS_BUCKET_NAME=
